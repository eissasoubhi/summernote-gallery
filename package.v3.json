{
  "name": "summernote-gallery",
  "version": "3.0.0-rc.0",
  "description": "Native Summernote gallery plugin with backend-agnostic image sources and semantic persisted HTML.",
  "type": "module",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "browser": "./dist/index.umd.cjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "jquery": ">=3.6.0 <4",
    "summernote": ">=0.9.1 <0.10"
  },
  "keywords": [
    "summernote",
    "summernote-plugin",
    "wysiwyg",
    "gallery",
    "image-gallery",
    "semantic-html"
  ],
  "homepage": "https://eissasoubhi.github.io/summernote-gallery",
  "bugs": "https://github.com/eissasoubhi/summernote-gallery/issues",
  "repository": "https://github.com/eissasoubhi/summernote-gallery",
  "author": "Eissa Soubhi <eissa.soubhi@gmail.com>",
  "license": "MIT"
}
