{
  "name": "summernote-gallery",
  "version": "3.0.0-rc.0",
  "description": "Native Summernote gallery plugin with backend-agnostic image sources and semantic persisted HTML.",
  "type": "module",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "browser": "./dist/index.umd.cjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "peerDependencies": {
    "jquery": ">=3.6.0 <4",
    "summernote": ">=0.9.1 <0.10"
  },
  "scripts": {
    "typecheck": "tsc -p v3-tooling/tsconfig.json --noEmit",
    "test": "vitest run --config v3-tooling/vitest.config.ts",
    "build:js": "vite build --config v3-tooling/vite.config.ts",
    "build:types": "tsc -p v3-tooling/tsconfig.build.json",
    "build": "npm run build:js && npm run build:types",
    "pack:check": "node v3-tooling/scripts/validate-root-package.mjs",
    "check": "npm run typecheck && npm run test && npm run build && npm run pack:check"
  },
  "devDependencies": {
    "@types/jquery": "^3.5.32",
    "@types/node": "^24.0.0",
    "@types/summernote": "^0.8.7",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.0"
  },
  "keywords": ["summernote", "summernote-plugin", "wysiwyg", "gallery", "image-gallery", "semantic-html"],
  "homepage": "https://eissasoubhi.github.io/summernote-gallery",
  "bugs": "https://github.com/eissasoubhi/summernote-gallery/issues",
  "repository": "https://github.com/eissasoubhi/summernote-gallery",
  "author": "Eissa Soubhi <eissa.soubhi@gmail.com>",
  "license": "MIT"
}
