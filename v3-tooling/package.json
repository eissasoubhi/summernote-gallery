{
  "name": "summernote-gallery-v3-tooling",
  "version": "0.0.0-dev",
  "private": true,
  "type": "module",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {".": {"types": "./dist/types/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.umd.cjs"}},
  "files": ["dist"],
  "peerDependencies": {
    "jquery": ">=3.6.0 <4",
    "summernote": ">=0.9.1 <0.10"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "build:js": "vite build --config vite.config.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "npm run build:js && npm run build:types",
    "pack:check": "node scripts/validate-pack.mjs",
    "check": "npm run typecheck && npm run test && npm run build && npm run pack:check"
  },
  "devDependencies": {
    "@types/jquery": "^3.5.32",
    "@types/node": "^24.0.0",
    "@types/summernote": "^0.8.7",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.0"
  }
}
